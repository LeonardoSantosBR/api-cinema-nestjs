generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int            @id @default(autoincrement())
  name        String
  cpf         String         @unique
  password    String         @db.LongText
  created_at  DateTime       @default(now())
  updated_at  DateTime?
  deleted_at  DateTime?
  seasonSeats SessionSeats[]
  userRoles   UsersRoles[]

  @@map("users")
}

model UsersRoles {
  id      Int   @id @default(autoincrement())
  user_id Int
  role_id Int
  user    Users @relation(fields: [user_id], references: [id])
  role    Roles @relation(fields: [role_id], references: [id])

  @@map("users_roles")
}

model Roles {
  id         Int          @id @default(autoincrement())
  name       String       @unique
  created_at DateTime     @default(now())
  updated_at DateTime?
  deleted_at DateTime?
  userRoles  UsersRoles[]

  @@map("roles")
}

model Cinemas {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  location   String?
  created_at DateTime  @default(now())
  updated_at DateTime?
  deleted_at DateTime?
  rooms      Rooms[]

  @@map("cinemas")
}

model Movies {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  synopsis       String              @db.LongText
  in_theaters    Boolean             @default(false)
  duration       String
  classification MovieClassification
  created_at     DateTime            @default(now())
  updated_at     DateTime?
  deleted_at     DateTime?
  sessions       Sessions[]

  @@map("movies")
}

model Sessions {
  id            Int            @id @default(autoincrement())
  movie_id      Int
  room_id       Int
  starts_at     DateTime
  ends_at       DateTime
  is_expired    Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime?
  deleted_at    DateTime?
  room          Rooms          @relation(fields: [room_id], references: [id])
  movie         Movies         @relation(fields: [movie_id], references: [id])
  session_seats SessionSeats[]

  @@map("sessions")
}

model Rooms {
  id         Int        @id @default(autoincrement())
  name       String
  cinema_id  Int
  created_at DateTime   @default(now())
  updated_at DateTime?
  deleted_at DateTime?
  cinema     Cinemas    @relation(fields: [cinema_id], references: [id])
  rows       RowsRoom[]
  sessions   Sessions[]

  @@map("rooms")
}

model RowsRoom {
  id         Int       @id @default(autoincrement())
  room_id    Int
  row_label  String    @db.Char(1)
  created_at DateTime  @default(now())
  updated_at DateTime?
  deleted_at DateTime?
  room       Rooms     @relation(fields: [room_id], references: [id])
  seats      Seats[]

  @@map("rows_room")
}

model Seats {
  id            Int            @id @default(autoincrement())
  row_id        Int
  seat_number   Int
  is_accessible Boolean        @default(false)
  created_at    DateTime       @default(now())
  updated_at    DateTime?
  deleted_at    DateTime?
  row           RowsRoom       @relation(fields: [row_id], references: [id])
  session_seats SessionSeats[]

  @@map("seats")
}

model SessionSeats {
  id          Int       @id @default(autoincrement())
  user_id     Int
  session_id  Int
  seat_id     Int
  is_reserved Boolean   @default(true)
  created_at  DateTime  @default(now())
  updated_at  DateTime?
  deleted_at  DateTime?
  session     Sessions  @relation(fields: [session_id], references: [id])
  seat        Seats     @relation(fields: [seat_id], references: [id])
  user        Users     @relation(fields: [user_id], references: [id])

  @@map("session_seats")
}

enum MovieClassification {
  FREE
  PLUS12
  PLUS16
  PLUS18
}
